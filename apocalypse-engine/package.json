{
  "name": "apocalypse-engine",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=browser",
    "test:soak": "playwright test --project=soak",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "lucide": "npm:lucide-static@0.577.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "@types/three": "0.184.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
